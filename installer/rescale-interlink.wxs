<?xml version="1.0" encoding="UTF-8"?>
<!--
  Rescale Interlink Windows installer. build\build_installer.ps1 (release) and
  build\windows_local_build\installer.ps1 (local) build it with the WiX UI
  extension, passing BuildDir, SourceDir and Version.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!-- Product definition -->
  <!-- Per user, so installing needs no administrator rights -->
  <Package Name="Rescale Interlink"
           Manufacturer="Rescale, Inc."
           Version="$(var.Version).0"
           UpgradeCode="8B7E9C4A-3F2D-4E1A-B5C6-7D8E9F0A1B2C"
           Scope="perUser"
           Language="1033"
           InstallerVersion="500">

    <SummaryInformation Description="Rescale Interlink - Unified CLI and GUI for Rescale HPC platform"
                        Manufacturer="Rescale, Inc." />

    <!-- Upgrade handling -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed."
                  AllowSameVersionUpgrades="yes" />

    <!-- Media definition -->
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Features -->
    <Feature Id="MainFeature" Title="Rescale Interlink" Level="1">
      <ComponentGroupRef Id="MainComponents" />
      <ComponentGroupRef Id="WebView2Components" />
      <ComponentGroupRef Id="StartMenuShortcuts" />
    </Feature>

    <!-- Auto-download no longer runs as a Windows service. It runs as a
         subprocess in the logged-in user's session, started by the tray app.
         No service is installed by this MSI. -->

    <Feature Id="TrayFeature" Title="System Tray Companion" Level="1">
      <ComponentGroupRef Id="TrayComponents" />
    </Feature>

    <!-- Custom actions -->
    <!-- Best-effort removal of a Windows service installed by older Interlink
         versions. Runs on uninstall/upgrade so a stale SYSTEM service (which
         could not reach user-mapped network drives) does not linger. -->
    <CustomAction Id="UninstallService"
                  Directory="INSTALLFOLDER"
                  ExeCommand="[INSTALLFOLDER]rescale-int.exe service uninstall"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- Terminate all Interlink processes before removing files. This must run
         BEFORE InstallValidate: that is where MSI's Restart Manager scans for
         in-use files, and any of the three executables being locked (the GUI
         and tray have windows; the daemon rescale-int.exe is a detached,
         windowless subprocess Restart Manager cannot close) makes uninstall
         prompt to "close these programs" and hang. A repair, an upgrade, or a
         Change that removes a feature replaces or removes the same files, so
         it runs then too.

         An IMMEDIATE action is used because deferred actions cannot run before
         InstallValidate; it runs as the installing user, in their session,
         where these per-user processes live. The USERNAME filter limits
         taskkill to that user's own processes: another signed-in user's
         Interlink runs from their own per-user install, and an elevated
         uninstall must leave it alone. taskkill /F force-closes them.
         Return="ignore": nothing running to close is not an error. -->
    <CustomAction Id="StopInterlinkProcesses"
                  Directory="INSTALLFOLDER"
                  ExeCommand="[SystemFolder]taskkill.exe /F /FI &quot;USERNAME eq [LogonUser]&quot; /IM rescale-int-gui.exe /IM rescale-int-tray.exe /IM rescale-int.exe"
                  Execute="immediate"
                  Return="ignore" />

    <!-- The installer deliberately does NOT launch any process at install time.
         The tray (rescale-int-tray.exe) is registered under HKCU ...\Run and
         starts at the next logon; it then auto-starts the auto-download daemon
         when it is enabled in daemon.conf. Users can also launch the tray or
         GUI immediately from the Start Menu / desktop shortcuts. -->

    <!-- Install sequence -->
    <!-- On removal, repair or upgrade: kill running processes before the
         in-use scan. On removal, then clean up any legacy Windows service. No
         process is started on install. -->
    <InstallExecuteSequence>
      <!-- Kill running Interlink processes before the in-use file scan
           (InstallValidate) so no removal, repair or upgrade prompts or hangs
           on a locked exe. REMOVE is set on uninstall and when a Change
           removes a feature, REINSTALL on a repair, and WIX_UPGRADE_DETECTED
           (MajorUpgrade's) when this package replaces an earlier version. A
           Change that only adds a feature replaces nothing and kills nothing. -->
      <Custom Action="StopInterlinkProcesses" Before="InstallValidate" Condition="REMOVE OR REINSTALL OR WIX_UPGRADE_DETECTED" />
      <Custom Action="UninstallService" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>

    <!-- UI reference - WiX v4 uses ui:WixUI from UI extension -->
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <ui:WixUI Id="WixUI_FeatureTree" />

    <!-- Product icon for shortcuts and Add/Remove Programs -->
    <Icon Id="ProductIcon.ico" SourceFile="rescale-interlink.ico" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon.ico" />

  </Package>

  <!-- Directory structure -->
  <!-- Under LocalAppData, for the per-user install -->
  <Fragment>
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="MANUFACTURERFOLDER" Name="Rescale">
        <Directory Id="INSTALLFOLDER" Name="Interlink">
          <Directory Id="WEBVIEW2FOLDER" Name="webview2" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Rescale Interlink" />
    </StandardDirectory>
  </Fragment>

  <!-- Main application components -->
  <Fragment>
    <ComponentGroup Id="MainComponents" Directory="INSTALLFOLDER">
      <!-- GUI application (Wails-based, with embedded frontend) -->
      <Component Id="GuiExecutable" Guid="1A2B3C4D-5E6F-7A8B-9C0D-E1F2A3B4C5D6">
        <File Id="RescaleIntGuiExe" Source="$(var.BuildDir)\rescale-int-gui.exe" KeyPath="yes">
          <!-- Desktop shortcut with explicit icon -->
          <Shortcut Id="DesktopShortcut"
                    Directory="DesktopFolder"
                    Name="Rescale Interlink"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="ProductIcon.ico"
                    Advertise="yes" />
        </File>
      </Component>

      <!-- CLI tool (standalone Go binary) -->
      <Component Id="CliExecutable" Guid="1A2B3C4D-5E6F-7A8B-9C0D-E1F2A3B4C5D7">
        <File Id="RescaleIntExe" Source="$(var.BuildDir)\rescale-int.exe" KeyPath="yes" />
      </Component>

      <!-- Icon file for shortcuts (multi-resolution 16-256px) -->
      <Component Id="IconFile" Guid="7A8B9C0D-1E2F-3A4B-5C6D-E7F8A9B0C1D2">
        <File Id="ProductIconFile" Source="rescale-interlink.ico" KeyPath="yes" />
      </Component>

      <Component Id="ReadmeFile" Guid="2B3C4D5E-6F7A-8B9C-0D1E-F2A3B4C5D6E7">
        <File Id="ReadmeTxt" Source="$(var.SourceDir)\README.txt" KeyPath="yes" />
      </Component>

      <Component Id="LicenseFile" Guid="3C4D5E6F-7A8B-9C0D-1E2F-A3B4C5D6E7F8">
        <File Id="LicenseTxt" Source="$(var.SourceDir)\LICENSE.txt" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <!-- WebView2 Fixed Version Runtime components -->
  <!-- Bundled runtime enables GUI on Windows Server 2019 without system-wide installation -->
  <Fragment>
    <ComponentGroup Id="WebView2Components" Directory="WEBVIEW2FOLDER">
      <!-- Use Files element for dynamic harvesting of webview2 folder contents -->
      <Files Include="$(var.BuildDir)\webview2\**">
        <Exclude Files="$(var.BuildDir)\webview2\**\.gitkeep" />
      </Files>
    </ComponentGroup>
  </Fragment>

  <!-- No ServiceComponents: auto-download runs as a user-session subprocess,
       not a Windows service. -->

  <!-- Tray companion components -->
  <Fragment>
    <ComponentGroup Id="TrayComponents" Directory="INSTALLFOLDER">
      <Component Id="TrayExecutable" Guid="5E6F7A8B-9C0D-1E2F-3A4B-C5D6E7F8A9B0">
        <File Id="TrayExe" Source="$(var.BuildDir)\rescale-int-tray.exe" KeyPath="yes" />

        <!-- Auto-start the tray at logon. The tray (not the installer) is what
             brings up auto-download: on launch it starts the daemon when it is
             enabled in daemon.conf. The value is quoted so a profile path
             containing spaces still launches correctly. -->
        <RegistryKey Root="HKCU" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run">
          <RegistryValue Name="RescaleInterlinkTray"
                         Type="string"
                         Value="&quot;[INSTALLFOLDER]rescale-int-tray.exe&quot;" />
        </RegistryKey>
      </Component>
    </ComponentGroup>
  </Fragment>

  <!-- Start menu shortcuts -->
  <Fragment>
    <ComponentGroup Id="StartMenuShortcuts" Directory="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="6F7A8B9C-0D1E-2F3A-4B5C-D6E7F8A9B0C1">
        <!-- GUI shortcut with explicit icon -->
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="Rescale Interlink"
                  Description="Unified CLI and GUI for Rescale HPC platform"
                  Target="[INSTALLFOLDER]rescale-int-gui.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="ProductIcon.ico" />

        <!-- CLI shortcut with explicit icon -->
        <Shortcut Id="CLIStartMenuShortcut"
                  Name="Rescale Interlink (Command Line)"
                  Description="Open command prompt with Rescale Interlink CLI"
                  Target="[SystemFolder]cmd.exe"
                  Arguments="/k &quot;cd /d [INSTALLFOLDER] &amp;&amp; rescale-int.exe --help&quot;"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="ProductIcon.ico" />

        <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="SOFTWARE\Rescale\Interlink" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <StandardDirectory Id="DesktopFolder" />
  </Fragment>

</Wix>
