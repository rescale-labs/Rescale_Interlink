# Enforce LF line endings for the whole repository.
#
# `text=auto eol=lf` tells Git to treat files as text and normalize them to LF
# in the repository AND check them out with LF, regardless of each developer's
# core.autocrlf / core.eol setting. This keeps line endings consistent across
# Windows, macOS, and Linux and avoids spurious CRLF diffs.
* text=auto eol=lf

# Binary files: never normalize or diff as text.
*.png     binary
*.ico     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.icns    binary
*.exe     binary
*.dll     binary
*.msi     binary
*.zip     binary
*.gz      binary
*.tar     binary
*.pdf     binary
