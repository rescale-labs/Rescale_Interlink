# Enforce LF line endings for the whole repository.
#
# `text=auto eol=lf` tells Git to treat files as text and normalize them to LF
# in the repository AND check them out with LF, regardless of each developer's
# core.autocrlf / core.eol setting. This keeps line endings consistent across
# Windows, macOS, and Linux and avoids spurious CRLF diffs.
* text=auto eol=lf

# Explicit text types (belt-and-suspenders; covered by the wildcard above).
*.go      text eol=lf
*.mod     text eol=lf
*.sum     text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.js      text eol=lf
*.json    text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.ps1     text eol=lf
*.sh      text eol=lf
*.wxs     text eol=lf
*.xml     text eol=lf
*.manifest text eol=lf
*.desktop text eol=lf
*.plist   text eol=lf
*.rtf     text eol=lf
Makefile  text eol=lf

# Binary files: never normalize or diff as text.
*.png     binary
*.ico     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.icns    binary
*.exe     binary
*.dll     binary
*.msi     binary
*.zip     binary
*.gz      binary
*.tar     binary
*.pdf     binary
